# Copy to .env and fill in. Nothing here is required to try `whole-foods demo`.

# --- Reading the shopping history over IMAP (optional) ---------------------
# The mailbox that receives the Whole Foods receipts. This is whoever actually
# does the shopping — it does not have to be the person running the tool.
# The App Password must be created by that account holder at
# https://myaccount.google.com/apppasswords (Gmail blocks normal passwords for
# IMAP and SMTP). Treat it like a password: never commit .env.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- Emailing the order sheet (optional) -----------------------------------
WFA_MAIL_TO=
WFA_MAIL_FROM=

# --- Tuning ----------------------------------------------------------------
# How often the household shops, in days.
WFA_SHOP_INTERVAL_DAYS=7
# How far through its usual gap an item must be before it is proposed.
# 1.0 = exactly due; 0.8 proposes things slightly early, which suits a weekly shop.
WFA_DUE_THRESHOLD=0.8
# Optional caps on the proposed order.
WFA_BUDGET=
WFA_MAX_ITEMS=

# --- Paths (optional) ------------------------------------------------------
WFA_DATA_DIR=
WFA_OUT_DIR=
