# Personal access token from https://cloud.ouraring.com/personal-access-tokens
OURA_TOKEN=

# Morning brief email (Gmail SMTP with an App Password, not your normal password)
# Create one at https://myaccount.google.com/apppasswords
MAIL_TO=you@example.com
MAIL_FROM=you@gmail.com
GMAIL_APP_PASSWORD=

# Optional overrides
OURA_TIMEZONE=America/New_York
OURA_SLEEP_NEED_HOURS=8.0
