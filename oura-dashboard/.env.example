# --- Oura OAuth2 ---------------------------------------------------------
# Register an application at https://cloud.ouraring.com/oauth/applications and
# add http://localhost:8731/callback to its redirect URIs.
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# Filled in by `oura-dashboard authorize`, which caches it in
# data/.oauth.json. Only needed here if you want to pin it explicitly.
# NOTE: Oura refresh tokens are SINGLE USE and rotate on every exchange, so
# do not share one value between your machine and the GitHub Actions job.
OURA_REFRESH_TOKEN=

# Legacy: a personal access token. Oura has deprecated these and no longer
# issues new ones, but an existing token still works and takes precedence.
OURA_TOKEN=

# --- Morning brief email (Gmail SMTP with an App Password) ---------------
# Create one at https://myaccount.google.com/apppasswords
MAIL_TO=you@example.com
MAIL_FROM=you@gmail.com
GMAIL_APP_PASSWORD=

# --- Optional overrides --------------------------------------------------
OURA_TIMEZONE=America/New_York
OURA_SLEEP_NEED_HOURS=8.0
